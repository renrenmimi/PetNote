rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========= Helper functions =========

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admin status is decided by the admin/state document, never by the token.
    //
    // This used to trust a POSITIVE `admin` custom claim on its own, as a cheap
    // path with no Firestore read, falling back to the document only when the
    // token didn't carry the claim. That was unsound in one direction, and the
    // direction matters:
    //
    //   isNotBanned() trusts a positive `banned` claim → a STALE claim keeps
    //     someone banned slightly too long. Fails safe.
    //   isAdmin() trusting a positive `admin` claim → a STALE claim keeps
    //     someone an admin for the rest of that token's life. Fails open.
    //
    // onAdminStateWritten clears the claim on demotion but nothing revokes the
    // already-issued ID token, and rules only verify a JWT's signature and
    // expiry — not that the claim inside it is still true, nor even that the
    // Auth user still exists. So a demoted admin kept full admin power for up
    // to an hour, and `role` being writable with it made that permanent: write
    // {role:'admin'} back to your own admin/state on the stale claim, and the
    // trigger re-issues the claim for real.
    //
    // Reading the document is what the callables have always done
    // (getNotificationActor), so this makes the two layers agree. Cost is one
    // document read wherever isAdmin() is actually reached; it sits behind a
    // short-circuit on every hot path (see the `|| isAdmin()` shapes below).
    //
    // exists() must come first so this returns FALSE rather than raising an
    // evaluation error for a user with no admin/state doc — an error would
    // propagate through `isAdmin() || (own record)` and lock ordinary users out
    // of their own reports and feedback. That is #150, pinned by a test.
    function isAdmin() {
      let adminDoc = /databases/$(database)/documents/users/$(request.auth.uid)/admin/state;
      return isAuthenticated() &&
        exists(adminDoc) &&
        'role' in get(adminDoc).data &&
        get(adminDoc).data.role == 'admin';
    }

    function isNotBanned() {
      let adminDoc = /databases/$(database)/documents/users/$(request.auth.uid)/admin/state;
      // Positive token claim → confirmed banned, no fallback needed.
      // Negative/missing token claim → check Firestore in case a brand-new
      // ban hasn't propagated to the caller's id token yet.
      // The `banned` custom claim is only ever set for actually-banned users
      // (onAdminStateWritten sets {banned:true}, never false), so normal users
      // have NO `banned` key on their token. We must tolerate the missing key
      // explicitly — `request.auth.token.banned != true` on an absent claim
      // does not behave as "not banned", which would wrongly deny every
      // unbanned user (likes/bookmarks/settings/blockedUsers all rely on this).
      return isAuthenticated() &&
        (!('banned' in request.auth.token) || request.auth.token.banned != true) &&
        (
          !exists(adminDoc) ||
          !('banned' in get(adminDoc).data) ||
          get(adminDoc).data.banned != true
        );
    }

    // Block direct client writes while the account is mid-deletion. The
    // deleteUserAccount callable sets users/{uid}.deletionPending = true at
    // the start of its cascade; without this check the user could keep
    // creating new likes / bookmarks faster than the cleanup deletes them.
    function isNotDeleting() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return isAuthenticated() && (
        !exists(userDoc) ||
        !('deletionPending' in get(userDoc).data) ||
        get(userDoc).data.deletionPending != true
      );
    }

    function isAllowedUserUpdate() {
      // Profile identity fields are written exclusively by callable functions
      // so displayName uniqueness is enforced through /usernames reservations.
      let allowed = ['location', 'onboardingComplete'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed) &&
        hasSafePublicLocation(request.resource.data);
    }

    // Safe fields allowed during user document creation.
    // Prevents setting role, banned, or other sensitive fields on create.
    function isAllowedUserCreate() {
      let allowed = ['location', 'onboardingComplete'];
      return request.resource.data.keys().hasOnly(allowed) &&
        hasSafePublicLocation(request.resource.data);
    }

    // Which keys may EXIST on an admin/state document. `role` stays in this
    // list deliberately: it is written by the Admin SDK (console, or
    // functions/scripts/migrate-admin-state.js), which bypasses rules, so a
    // real document legitimately carries it. Dropping it here would not stop
    // a client writing role — it would stop a client banning anyone whose
    // document already has one, because request.resource.data on an update is
    // the whole POST-WRITE document, not the changed keys. That is the same
    // trap hasSafePublicLocation fell into; see the audit note on it.
    //
    // Whether a client may write `role` is enforced per-operation below.
    function isAllowedAdminStateWrite() {
      let allowed = ['role', 'banned', 'bannedReason', 'bannedAt'];
      return request.resource.data.keys().hasOnly(allowed);
    }

    function hasSafePublicLocation(userData) {
      return !('location' in userData) || (
        userData.location is map &&
        userData.location.keys().hasOnly(['city', 'state', 'updatedAt']) &&
        (!('city' in userData.location) || userData.location.city is string) &&
        (!('state' in userData.location) || userData.location.state is string)
      );
    }

    // ----- private per-user settings docs -----
    // Two known documents live under users/{uid}/settings, both written from
    // the client with setDoc(..., { merge: true }):
    //   - 'preferences' : notification toggles + language (services/settings.ts)
    //   - 'location'    : the user's private precise coordinates (services/location.ts)
    // Any other settingId is rejected. Keys are whitelisted per doc; on create
    // we check the whole document, on update only the changed keys (so a
    // pre-existing doc carrying a legacy field can't be retro-locked, yet no
    // new unknown key can be introduced). Each known field is type-checked.
    function settingsKeysOk(settingId, affectedKeys) {
      return (settingId == 'preferences' &&
                affectedKeys.hasOnly(['likeNotifications', 'commentNotifications', 'followNotifications', 'language'])) ||
             (settingId == 'location' &&
                affectedKeys.hasOnly(['lat', 'lng', 'city', 'state', 'updatedAt']));
    }

    function settingsTypesOk(data) {
      return (!('likeNotifications' in data) || data.likeNotifications is bool) &&
        (!('commentNotifications' in data) || data.commentNotifications is bool) &&
        (!('followNotifications' in data) || data.followNotifications is bool) &&
        (!('language' in data) || data.language is string) &&
        (!('lat' in data) || data.lat is number) &&
        (!('lng' in data) || data.lng is number) &&
        (!('city' in data) || data.city is string) &&
        (!('state' in data) || data.state is string) &&
        (!('updatedAt' in data) || data.updatedAt is timestamp);
    }

    // ========= users =========
    match /users/{userId} {
      allow read: if true;
      // Owner can only create with safe fields — no role, banned, email
      allow create: if isOwner(userId) && isAllowedUserCreate();
      allow update: if (isOwner(userId) && isAllowedUserUpdate()) || isAdmin();
      // User deletion is handled exclusively by backend account-deletion logic.
      allow delete: if false;

      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId);
        // Bookmark doc id IS the postId. Validate the post exists and the
        // user is in good standing on create; allow delete unconditionally
        // for the owner so cleanup paths work even after a ban or during
        // account deletion.
        allow create: if isOwner(userId) &&
          isNotBanned() &&
          isNotDeleting() &&
          exists(/databases/$(database)/documents/posts/$(bookmarkId));
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /following/{targetId} {
        allow read: if false;
        allow write: if false;
      }

      match /followingPets/{petId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /followers/{followerId} {
        allow read: if false;
        allow write: if false;
      }

      match /blockedUsers/{blockedId} {
        allow read: if isOwner(userId);
        // A block doc carries exactly one field: blockedAt (a server
        // timestamp). Banned / mid-deletion users can't mutate their block
        // list. Delete stays guarded too — the account-deletion cascade runs
        // server-side via the Admin SDK, which bypasses these rules.
        allow create: if isOwner(userId) && isNotBanned() && isNotDeleting() &&
          request.resource.data.keys().hasOnly(['blockedAt']) &&
          request.resource.data.blockedAt is timestamp;
        allow update: if isOwner(userId) && isNotBanned() && isNotDeleting() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['blockedAt']) &&
          request.resource.data.blockedAt is timestamp;
        allow delete: if isOwner(userId) && isNotBanned() && isNotDeleting();
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId) && isNotBanned() && isNotDeleting() &&
          settingsKeysOk(settingId, request.resource.data.keys()) &&
          settingsTypesOk(request.resource.data);
        allow update: if isOwner(userId) && isNotBanned() && isNotDeleting() &&
          settingsKeysOk(settingId, request.resource.data.diff(resource.data).affectedKeys()) &&
          settingsTypesOk(request.resource.data);
        // Keep delete owner-only (no banned/deleting gate): clearUserLocation
        // deletes settings/location directly from the client and we don't want
        // to wedge that path; the deletion cascade cleans the subtree server-side.
        allow delete: if isOwner(userId);
      }

      match /admin/state {
        allow read: if isOwner(userId) || isAdmin();
        // No client write may introduce or change `role`, not even an admin's.
        // Promotion is an owner operation through the console or the Admin SDK,
        // which bypass these rules; the app has never written role (the only
        // caller, blockUserByAdmin in src/services/admin.ts, writes the three
        // ban fields). Keeping it out of reach means one compromised admin
        // session cannot mint more admins, and — with isAdmin() now reading
        // this document rather than the token — closes the loop where a demoted
        // admin re-promoted themselves on a stale claim.
        allow create: if isAdmin() &&
          isAllowedAdminStateWrite() &&
          !('role' in request.resource.data);
        allow update: if isAdmin() &&
          isAllowedAdminStateWrite() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
        allow delete: if false;
      }
    }

    // ========= posts =========
    match /posts/{postId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      match /likes/{likeId} {
        allow read: if true;
        // Body fields are validated too: userId/postId feed the batched
        // collection-group like lookup and the account-deletion cascade, so
        // a forged body (userId: someone else, postId: another post) could
        // plant permanent phantom-like state on a victim.
        allow create: if isAuthenticated() &&
          request.auth.uid == likeId &&
          isNotBanned() &&
          isNotDeleting() &&
          request.resource.data.keys().hasOnly(['userId', 'postId', 'createdAt', 'counted']) &&
          request.resource.data.keys().hasAll(['counted']) &&
          request.resource.data.userId == request.auth.uid &&
          request.resource.data.postId == postId &&
          request.resource.data.createdAt is timestamp &&
          // onLikeCreated flips `counted` to true with the likeCount
          // increment, so a like the client writes must always say false.
          //
          // `counted` is REQUIRED, not just constrained. It used to be
          // optional — absent was allowed so clients running cached JS from
          // before the field shipped kept working — but shared.ts reads an
          // absent field as *already counted* (that reading is what lets the
          // scheme deploy without a backfill). The two halves together were
          // exploitable: write a like with no `counted`, delete it before
          // onLikeCreated runs, and onLikeDeleted sees the field missing,
          // concludes the like was counted, and applies increment(-1). The
          // create trigger then arrives, finds the doc gone and declines, so
          // nothing is ever added. Net -1 on someone else's post, repeatable
          // — likes have no rate limit and onLikeDeleted has no clamp.
          //
          // This governs new writes only, so the absent-means-counted reading
          // still protects likes written before this rule.
          request.resource.data.counted == false &&
          exists(/databases/$(database)/documents/posts/$(postId));
        // Allow delete during deletion so cleanup paths work even when the
        // user is being torn down.
        allow delete: if isAuthenticated() &&
          request.auth.uid == likeId &&
          isNotBanned();
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if false;
        allow delete: if false;
        allow update: if false;
      }
    }

    // ========= pets =========
    match /pets/{petId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      match /family/{userId} {
        allow read: if true;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      match /invitations/{code} {
        allow read: if false;
        allow create: if false;
        allow update: if false;
        allow delete: if false;
      }

      match /followers/{userId} {
        allow read: if true;
        allow create: if false;
        allow delete: if false;
        allow update: if false;
      }
    }

    match /invitationCodes/{code} {
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /usernames/{usernameId} {
      allow read: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Backend-only rate-limit buckets. These are written with Admin SDK by
    // callable functions and must never be readable or writable by clients.
    match /callableRateLimits/{docId} {
      allow read: if false;
      allow write: if false;
    }

    match /geoapifyRateLimits/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Backend-only account-deletion tombstones. Written with the Admin SDK by
    // deleteUserAccount; profile create/update callables check them to block
    // resurrection of a deleted account. Never client-readable or writable.
    match /userDeletionTombstones/{docId} {
      allow read: if false;
      allow write: if false;
    }

    // Backend-only ledger of trigger events that have already been applied.
    // Firestore delivers events at least once, so counter triggers write the
    // event id here inside the same transaction as the count; a redelivered
    // event finds the marker and does nothing. A client that could write here
    // could suppress a counter update, and one that could read it could
    // enumerate activity, so both are closed. Requires a TTL policy on
    // expiresAt — without one this collection grows forever.
    match /processedEvents/{eventId} {
      allow read: if false;
      allow write: if false;
    }

    // ========= notifications =========
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.read is bool &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ========= meetups =========
    match /meetups/{meetupId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      match /participants/{participantId} {
        allow read: if true;
        // Participant creation is handled exclusively by joinMeetup callable CF
        // which validates requirements, capacity, and creates with admin SDK.
        allow create: if false;
        allow delete: if isAuthenticated() && (
          request.auth.uid == participantId ||
          get(/databases/$(database)/documents/meetups/$(meetupId)).data.organizerId == request.auth.uid ||
          isAdmin()
        );
        // No client-side updates — participant data is set by joinMeetup callable only.
        allow update: if false;
      }

      // Private address: only organizer, confirmed participants, or admin can read.
      // Full address/coordinates stored here when locationVisibility == "participants_only".
      match /private/{docId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/meetups/$(meetupId)).data.organizerId == request.auth.uid ||
          exists(/databases/$(database)/documents/meetups/$(meetupId)/participants/$(request.auth.uid)) ||
          isAdmin()
        );
        allow create: if false;
        allow update: if false;
        allow delete: if isAuthenticated() &&
          (get(/databases/$(database)/documents/meetups/$(meetupId)).data.organizerId == request.auth.uid || isAdmin());
      }
    }

    // ========= locations =========
    match /locations/{locationId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      // Reviews: doc ID must be "{userId}" or "{userId}_{meetupId}" to enforce one-per-user.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if false;
        allow delete: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isAdmin());
        allow update: if false;
      }

      // Checkins are created by callable with deterministic daily doc IDs.
      match /checkins/{checkinId} {
        allow read: if true;
        allow create: if false;
        allow update: if false;
        allow delete: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ========= hashtags =========
    match /hashtags/{tagId} {
      allow read: if true;
      // Tag creation and updates are handled exclusively by Cloud Functions.
      // Client cannot write to hashtags directly.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========= reports =========
    match /reports/{reportId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.reporterId == request.auth.uid);
    }

    // ========= feedback =========
    match /feedback/{feedbackId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // ========= Collection Group queries =========
    match /{path=**}/checkins/{checkinId} {
      allow read: if true;
    }

    match /{path=**}/likes/{likeId} {
      allow read: if true;
    }

    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    match /{path=**}/participants/{participantId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }

    // bookmarks collection-group rule intentionally omitted: the
    // `users/{userId}/bookmarks/{postId}` rule above already gates owner
    // reads, and no client query reads bookmarks via the collection group.
    // (Server-side cleanup uses the Admin SDK and bypasses rules.)

    match /{path=**}/family/{userId} {
      allow read: if true;
    }

  }
}
