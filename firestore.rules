rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========= Helper functions =========

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isNotBanned() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(userDoc) ||
        !('banned' in get(userDoc).data) ||
        get(userDoc).data.banned != true;
    }

    // P0 #1: Only allow owner to update whitelisted fields.
    // Sensitive fields (role, banned, followerCount, etc.) are admin-only.
    function isAllowedUserUpdate() {
      let allowed = ['displayName', 'displayNameLower', 'avatarUrl', 'bio',
                      'location', 'onboardingComplete', 'pinnedPostId'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Count fields (followingPetsCount, followingCount, followerCount) are only
    // writable via the followingPets/followers subcollection rules below, which
    // trigger updates to the parent user doc. This separate check allows only
    // numeric increment-style updates to count fields.
    function isCounterUpdate() {
      let counters = ['followingPetsCount', 'followingCount', 'followerCount'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(counters);
    }

    // ========= users =========
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId);
      // P0 #1: owner can only update whitelisted fields; admin can update anything
      allow update: if (isOwner(userId) && (isAllowedUserUpdate() || isCounterUpdate())) || isAdmin();
      // P0 #4 (partial): allow owner OR admin to delete their own user doc
      allow delete: if isOwner(userId) || isAdmin();

      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /following/{targetId} {
        allow read: if true;
        allow write: if isOwner(userId) && isNotBanned();
      }

      match /followingPets/{petId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId) && isNotBanned();
      }

      match /followers/{followerId} {
        allow read: if true;
        // P0 #5: add isNotBanned check
        allow write: if isAuthenticated() && request.auth.uid == followerId && isNotBanned();
      }

      match /blockedUsers/{blockedId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // ========= posts =========
    match /posts/{postId} {
      allow read: if true;
      // P0 #5: add isNotBanned check to create
      allow create: if isAuthenticated() && isNotBanned();
      allow update: if isAuthenticated() &&
        (resource.data.authorId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.authorId == request.auth.uid || isAdmin());

      match /likes/{likeId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == likeId && isNotBanned();
        allow delete: if isAuthenticated() && request.auth.uid == likeId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated() && isNotBanned();
        allow delete: if isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid ||
          isAdmin()
        );
        allow update: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }
    }

    // ========= pets =========
    match /pets/{petId} {
      allow read: if true;
      allow create: if isAuthenticated() && isNotBanned() &&
        request.resource.data.ownerId == request.auth.uid;
      allow update: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || resource.data.primaryOwnerId == request.auth.uid);
      allow delete: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || resource.data.primaryOwnerId == request.auth.uid || isAdmin());

      match /family/{userId} {
        allow read: if true;
        // P0 #3: family creation requires either:
        //   a) user is the pet's primary owner (initial setup), OR
        //   b) user provides a valid invitation code that exists in the invitations subcollection
        allow create: if isAuthenticated() && request.auth.uid == userId && (
          get(/databases/$(database)/documents/pets/$(petId)).data.primaryOwnerId == request.auth.uid ||
          ('invitationCode' in request.resource.data &&
           exists(/databases/$(database)/documents/pets/$(petId)/invitations/$(request.resource.data.invitationCode)) &&
           get(/databases/$(database)/documents/pets/$(petId)/invitations/$(request.resource.data.invitationCode)).data.used == false &&
           get(/databases/$(database)/documents/pets/$(petId)/invitations/$(request.resource.data.invitationCode)).data.expiresAt > request.time)
        );
        allow update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/pets/$(petId)).data.primaryOwnerId == request.auth.uid ||
          get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid
        );
      }

      match /invitations/{code} {
        allow read: if isAuthenticated();
        // Only family members can create invitations
        allow create: if isAuthenticated() &&
          exists(/databases/$(database)/documents/pets/$(petId)/family/$(request.auth.uid));
        // P0 #3: only the invitation creator, primary owner, or admin can update
        allow update: if isAuthenticated() && (
          resource.data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/pets/$(petId)).data.primaryOwnerId == request.auth.uid ||
          isAdmin()
        );
        allow delete: if false;
      }

      match /followers/{userId} {
        allow read: if true;
        // P0 #5: add isNotBanned check
        allow create: if isAuthenticated() && request.auth.uid == userId && isNotBanned();
        allow delete: if isAuthenticated() && request.auth.uid == userId;
        allow update: if false;
      }
    }

    // ========= notifications =========
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;
      // P0 #2: prevent non-admin from creating warning notifications
      // Also require fromUserId matches auth uid to prevent impersonation
      allow create: if isAuthenticated() && isNotBanned() &&
        request.resource.data.fromUserId == request.auth.uid &&
        (request.resource.data.type != 'warning' || isAdmin());
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ========= meetups =========
    match /meetups/{meetupId} {
      allow read: if true;
      // P0 #5: add isNotBanned check to create
      allow create: if isAuthenticated() && isNotBanned();
      allow update: if isAuthenticated() &&
        (resource.data.organizerId == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.organizerId == request.auth.uid || isAdmin());

      match /participants/{participantId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == participantId && isNotBanned();
        allow delete: if isAuthenticated() && (
          request.auth.uid == participantId ||
          get(/databases/$(database)/documents/meetups/$(meetupId)).data.organizerId == request.auth.uid ||
          isAdmin()
        );
        allow update: if isAuthenticated() && request.auth.uid == participantId;
      }
    }

    // ========= locations =========
    match /locations/{locationId} {
      allow read: if true;
      // P0 #5: add isNotBanned check to create
      allow create: if isAuthenticated() && isNotBanned();
      // P0 #4: location creator or admin can update anything;
      // other authenticated users can only update aggregation fields (from reviews/checkins)
      allow update: if isAuthenticated() && isNotBanned() && (
        resource.data.addedBy == request.auth.uid ||
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(
          ['averageRating', 'totalRatings', 'totalCheckins', 'verifiedByCheckins',
           'totalPhotos', 'photos', 'tags', 'updatedAt']
        )
      );
      allow delete: if isAdmin();

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated() && isNotBanned();
        allow delete: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isAdmin());
        allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }

      match /checkins/{checkinId} {
        allow read: if true;
        allow create: if isAuthenticated() && isNotBanned();
        allow delete: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ========= hashtags =========
    match /hashtags/{tagId} {
      allow read: if true;
      allow create: if isAuthenticated() && isNotBanned();
      // P0 #4: only allow updating postCount and lastUsed (tag counting);
      // name and other fields cannot be tampered with
      allow update: if isAuthenticated() && isNotBanned() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['postCount', 'lastUsed']);
      allow delete: if isAdmin();
    }

    // ========= reports =========
    match /reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() && isNotBanned();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========= feedback =========
    match /feedback/{feedbackId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========= Collection Group queries =========
    match /{path=**}/checkins/{checkinId} {
      allow read: if true;
    }

    match /{path=**}/likes/{likeId} {
      allow read: if true;
    }

    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    match /{path=**}/participants/{participantId} {
      allow read: if true;
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }

    match /{path=**}/bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && request.auth.uid == bookmarkId;
    }

    match /{path=**}/family/{userId} {
      allow read: if true;
    }

    match /{path=**}/invitations/{code} {
      allow read: if isAuthenticated();
    }

    // P0 #6: REMOVED the overly permissive followingPets collection group rule.
    // The specific path /users/{userId}/followingPets/{petId} already has proper
    // owner-only rules above. No collection group query is needed for this data.
  }
}
