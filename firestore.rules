rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========= Helper functions =========

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isNotBanned() {
      let userDoc = /databases/$(database)/documents/users/$(request.auth.uid);
      return !exists(userDoc) ||
        !('banned' in get(userDoc).data) ||
        get(userDoc).data.banned != true;
    }

    function isEmailVerified() {
      return request.auth.token.email_verified == true;
    }

    function isAllowedUserUpdate() {
      let allowed = ['displayName', 'displayNameLower', 'avatarUrl', 'bio',
                      'location', 'onboardingComplete', 'pinnedPostId'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // Safe fields allowed during user document creation.
    // Prevents setting role, banned, or other sensitive fields on create.
    function isAllowedUserCreate() {
      let allowed = ['displayName', 'displayNameLower', 'avatarUrl', 'bio',
                      'location', 'onboardingComplete', 'createdAt'];
      return request.resource.data.keys().hasOnly(allowed);
    }

    function isAllowedPetCreate() {
      let allowed = ['ownerId', 'primaryOwnerId', 'name', 'nameLower', 'species',
                      'breed', 'birthday', 'age', 'gender', 'bio', 'avatarUrl',
                      'followerCount', 'createdAt'];
      return request.resource.data.keys().hasOnly(allowed) &&
        request.resource.data.ownerId == request.auth.uid &&
        request.resource.data.primaryOwnerId == request.auth.uid &&
        request.resource.data.followerCount == 0;
    }

    function isAllowedPetUpdate() {
      let allowed = ['name', 'nameLower', 'species', 'breed', 'birthday',
                      'age', 'gender', 'bio', 'avatarUrl'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function isAllowedMeetupCreate() {
      let allowed = ['organizerId', 'organizerName', 'organizerAvatar', 'title',
                      'description', 'coverImage', 'date', 'duration', 'location',
                      'locationId', 'locationVisibility', 'requirements', 'status',
                      'participantCount', 'isRatingOpen', 'createdAt', 'updatedAt'];
      return request.resource.data.keys().hasOnly(allowed) &&
        request.resource.data.organizerId == request.auth.uid &&
        request.resource.data.status == 'upcoming' &&
        request.resource.data.participantCount == 0 &&
        request.resource.data.isRatingOpen == false;
    }

    function isAllowedMeetupUpdate() {
      let allowed = ['title', 'description', 'coverImage', 'date', 'duration',
                      'location', 'locationId', 'locationVisibility', 'requirements',
                      'status', 'updatedAt', 'isRatingOpen'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    function isAllowedLocationCreate() {
      let allowed = ['name', 'category', 'description', 'address', 'lat', 'lng',
                      'city', 'state', 'features', 'photos', 'locationPhotos',
                      'addedBy', 'addedByName', 'averageRating', 'totalRatings',
                      'totalPhotos', 'totalCheckins', 'verifiedByCheckins', 'tags',
                      'source', 'verified', 'createdAt', 'updatedAt'];
      return request.resource.data.keys().hasOnly(allowed) &&
        request.resource.data.addedBy == request.auth.uid &&
        request.resource.data.averageRating == 0 &&
        request.resource.data.totalRatings == 0 &&
        request.resource.data.totalPhotos >= 0 &&
        request.resource.data.verified == false;
    }

    function isAllowedLocationUpdate() {
      let allowed = ['photos', 'locationPhotos', 'totalPhotos', 'updatedAt'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ========= users =========
    match /users/{userId} {
      allow read: if true;
      // Owner can only create with safe fields — no role, banned, email
      allow create: if isOwner(userId) && isAllowedUserCreate();
      allow update: if (isOwner(userId) && isAllowedUserUpdate()) || isAdmin();
      // Only admin can delete user documents. Account deletion flow uses
      // admin SDK via Cloud Function, not client-side deleteDoc.
      allow delete: if isAdmin();

      match /bookmarks/{bookmarkId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /following/{targetId} {
        allow read: if true;
        allow write: if isOwner(userId) && isNotBanned();
      }

      match /followingPets/{petId} {
        allow read: if isOwner(userId);
        allow create: if false;
        allow update: if false;
        allow delete: if isOwner(userId);
      }

      match /followers/{followerId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == followerId && isNotBanned();
      }

      match /blockedUsers/{blockedId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }

      match /settings/{settingId} {
        allow read: if isOwner(userId);
        allow write: if isOwner(userId);
      }
    }

    // ========= posts =========
    match /posts/{postId} {
      allow read: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if isAuthenticated() &&
        (resource.data.authorId == request.auth.uid || isAdmin());

      match /likes/{likeId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == likeId && isNotBanned();
        allow delete: if isAuthenticated() && request.auth.uid == likeId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if false;
        allow delete: if isAuthenticated() && (
          resource.data.authorId == request.auth.uid ||
          get(/databases/$(database)/documents/posts/$(postId)).data.authorId == request.auth.uid ||
          isAdmin()
        );
        allow update: if false;
      }
    }

    // ========= pets =========
    match /pets/{petId} {
      allow read: if true;
      allow create: if isAuthenticated() && isNotBanned() &&
        isAllowedPetCreate();
      allow update: if isAuthenticated() &&
        ((resource.data.ownerId == request.auth.uid || resource.data.primaryOwnerId == request.auth.uid) &&
         isAllowedPetUpdate());
      allow delete: if isAuthenticated() &&
        (resource.data.ownerId == request.auth.uid || resource.data.primaryOwnerId == request.auth.uid || isAdmin());

      match /family/{userId} {
        allow read: if true;
        allow create: if isAuthenticated() && request.auth.uid == userId && (
          get(/databases/$(database)/documents/pets/$(petId)).data.primaryOwnerId == request.auth.uid ||
          ('invitationCode' in request.resource.data &&
           exists(/databases/$(database)/documents/pets/$(petId)/invitations/$(request.resource.data.invitationCode)) &&
           get(/databases/$(database)/documents/pets/$(petId)/invitations/$(request.resource.data.invitationCode)).data.used == false &&
           get(/databases/$(database)/documents/pets/$(petId)/invitations/$(request.resource.data.invitationCode)).data.expiresAt > request.time)
        );
        allow update: if isAuthenticated() && request.auth.uid == userId;
        allow delete: if isAuthenticated() && (
          request.auth.uid == userId ||
          get(/databases/$(database)/documents/pets/$(petId)).data.primaryOwnerId == request.auth.uid ||
          get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid
        );
      }

      match /invitations/{code} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
          exists(/databases/$(database)/documents/pets/$(petId)/family/$(request.auth.uid));
        // Redemption: any authenticated user can mark unused invitation as used,
        // but usedBy MUST match their own UID (prevents claiming as someone else)
        allow update: if isAuthenticated() && (
          resource.data.createdBy == request.auth.uid ||
          get(/databases/$(database)/documents/pets/$(petId)).data.primaryOwnerId == request.auth.uid ||
          isAdmin() ||
          (resource.data.used == false &&
           request.resource.data.used == true &&
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'usedBy', 'usedByName']) &&
           request.resource.data.usedBy == request.auth.uid)
        );
        allow delete: if false;
      }

      match /followers/{userId} {
        allow read: if true;
        allow create: if false;
        allow delete: if isAuthenticated() && (
          get(/databases/$(database)/documents/pets/$(petId)).data.ownerId == request.auth.uid ||
          get(/databases/$(database)/documents/pets/$(petId)).data.primaryOwnerId == request.auth.uid ||
          isAdmin()
        );
        allow update: if false;
      }
    }

    // ========= notifications =========
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid || resource.data.fromUserId == request.auth.uid);
      allow create: if false;
      allow update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow delete: if isAuthenticated() &&
        (resource.data.userId == request.auth.uid ||
         resource.data.fromUserId == request.auth.uid ||
         isAdmin());
    }

    // ========= meetups =========
    match /meetups/{meetupId} {
      allow read: if true;
      allow create: if isAuthenticated() && isNotBanned() && isEmailVerified() &&
        isAllowedMeetupCreate();
      allow update: if isAuthenticated() &&
        ((resource.data.organizerId == request.auth.uid && isAllowedMeetupUpdate()) || isAdmin());
      allow delete: if isAuthenticated() &&
        (resource.data.organizerId == request.auth.uid || isAdmin());

      match /participants/{participantId} {
        allow read: if true;
        // Participant creation is handled exclusively by joinMeetup callable CF
        // which validates requirements, capacity, and creates with admin SDK.
        allow create: if false;
        allow delete: if isAuthenticated() && (
          request.auth.uid == participantId ||
          get(/databases/$(database)/documents/meetups/$(meetupId)).data.organizerId == request.auth.uid ||
          isAdmin()
        );
        // No client-side updates — participant data is set by joinMeetup callable only.
        allow update: if false;
      }

      // Private address: only organizer, confirmed participants, or admin can read.
      // Full address/coordinates stored here when locationVisibility == "participants_only".
      match /private/{docId} {
        allow read: if isAuthenticated() && (
          get(/databases/$(database)/documents/meetups/$(meetupId)).data.organizerId == request.auth.uid ||
          exists(/databases/$(database)/documents/meetups/$(meetupId)/participants/$(request.auth.uid)) ||
          isAdmin()
        );
        allow write: if isAuthenticated() &&
          (get(/databases/$(database)/documents/meetups/$(meetupId)).data.organizerId == request.auth.uid || isAdmin());
      }
    }

    // ========= locations =========
    match /locations/{locationId} {
      allow read: if true;
      allow create: if isAuthenticated() && isNotBanned() && isEmailVerified() &&
        isAllowedLocationCreate();
      // Only location creator or admin can update. Aggregation fields
      // (averageRating, totalRatings, totalCheckins, etc.) are maintained
      // exclusively by Cloud Functions using admin SDK.
      allow update: if isAuthenticated() && isNotBanned() &&
        ((resource.data.addedBy == request.auth.uid && isAllowedLocationUpdate()) || isAdmin());
      allow delete: if isAdmin();

      // Reviews: doc ID must be "{userId}" or "{userId}_{meetupId}" to enforce one-per-user.
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if false;
        allow delete: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isAdmin());
        allow update: if false;
      }

      // Checkins are created by callable with deterministic daily doc IDs.
      match /checkins/{checkinId} {
        allow read: if true;
        allow create: if false;
        allow update: if false;
        allow delete: if isAuthenticated() &&
          (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // ========= hashtags =========
    match /hashtags/{tagId} {
      allow read: if true;
      // Tag creation and updates are handled exclusively by Cloud Functions.
      // Client cannot write to hashtags directly.
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ========= reports =========
    match /reports/{reportId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.reporterId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.reporterId == request.auth.uid);
    }

    // ========= feedback =========
    match /feedback/{feedbackId} {
      allow read: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update: if isAdmin();
      allow delete: if isAdmin() ||
        (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    // ========= Collection Group queries =========
    match /{path=**}/checkins/{checkinId} {
      allow read: if true;
    }

    match /{path=**}/likes/{likeId} {
      allow read: if true;
    }

    match /{path=**}/comments/{commentId} {
      allow read: if true;
    }

    match /{path=**}/participants/{participantId} {
      allow read: if true;
    }

    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }

    match /{path=**}/bookmarks/{bookmarkId} {
      allow read: if isAuthenticated() && request.auth.uid == bookmarkId;
    }

    match /{path=**}/family/{userId} {
      allow read: if true;
    }

    match /{path=**}/invitations/{code} {
      allow read: if isAuthenticated();
    }
  }
}
