+
+/// ManualDeadline as it is at HEAD, copied, with one change: the timer is late.
+///
+/// `.parks`: the deadline is recorded when the model starts it (as
+/// ManualDeadline does) but parks - becomes reachable by `pass()` - only late.
+/// `.starts`: it is also recorded late.
+///
+/// "Late" is made certain rather than likely. The lateness runs on the main
+/// actor, where the test runs too: it waits until `after()` holds (the request
+/// has reached the repository), then gives the main actor away `turns` more
+/// times. The test is polling on the main actor all that while, so whatever it
+/// does in the turn it first sees the request - count the deadlines, or pass
+/// them - happens before the timer starts or parks.
+private final class LateTimerDeadline: @unchecked Sendable {
+    enum Lateness: Sendable { case parks, starts }
+
+    private let lock = NSLock()
+    private var started: [Duration] = []
+    private var waiting: [Int: CheckedContinuation<Void, Never>] = [:]
+    private var cancelledEarly: Set<Int> = []
+    private var nextID = 0
+
+    private let lateness: Lateness
+    private let after: @MainActor @Sendable () -> Bool
+    private let turns: Int
+
+    init(_ lateness: Lateness, after: @escaping @MainActor @Sendable () -> Bool, turns: Int = 50) {
+        self.lateness = lateness
+        self.after = after
+        self.turns = turns
+    }
+
+    var sleeper: @Sendable (Duration) async throws -> Void {
+        { [self] duration in try await self.wait(duration) }
+    }
+
+    var durations: [Duration] { lock.withLock { started } }
+
+    var armed: Int { lock.withLock { waiting.count } }
+
+    func waitUntilArmed(_ count: Int = 1) async -> Bool {
+        for _ in 0..<20_000 {
+            if armed >= count { return true }
+            await Task.yield()
+        }
+        return false
+    }
+
+    func passOnceArmed(_ count: Int = 1, sourceLocation: SourceLocation = #_sourceLocation) async {
+        guard await waitUntilArmed(count) else {
+            Issue.record("no deadline parked to pass (armed \(armed), started \(durations.count))",
+                         sourceLocation: sourceLocation)
+            return
+        }
+        pass()
+    }
+
+    func pass() {
+        let due = lock.withLock { () -> [CheckedContinuation<Void, Never>] in
+            defer { waiting.removeAll() }
+            return Array(waiting.values)
+        }
+        for continuation in due { continuation.resume() }
+    }
+
+    /// The injected lateness. See the type's note.
+    @MainActor private func beLate() async {
+        for _ in 0..<20_000 {
+            if after() { break }
+            await Task.yield()
+        }
+        for _ in 0..<turns { await Task.yield() }
+    }
+
+    private func wait(_ duration: Duration) async throws {
+        if lateness == .starts { await beLate() }
+        let id = lock.withLock { () -> Int in
+            started.append(duration)
+            nextID += 1
+            return nextID
+        }
+        if lateness == .parks { await beLate() }
+        await withTaskCancellationHandler {
+            await withCheckedContinuation { (continuation: CheckedContinuation<Void, Never>) in
+                let resumeNow = lock.withLock { () -> Bool in
+                    if cancelledEarly.remove(id) != nil { return true }
+                    waiting[id] = continuation
+                    return false
+                }
+                if resumeNow { continuation.resume() }
+            }
+        } onCancel: {
+            let continuation = lock.withLock { () -> CheckedContinuation<Void, Never>? in
+                if let stored = waiting.removeValue(forKey: id) { return stored }
+                cancelledEarly.insert(id)
+                return nil
+            }
+            continuation?.resume()
+        }
+        try Task.checkCancellation()
+    }
+}
