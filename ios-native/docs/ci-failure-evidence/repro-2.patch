+// TEMPORARY - DO NOT COMMIT. Evidence for the owner (2026-09-23), not a test
+// of the app. Remove with `git apply -R repro-2.patch` or by deleting this file.
+//
+// Deterministic reproduction of CI run 35924362700 (3b4f497, Apple M1 (Virtual),
+// 3 vCPU, 7 GiB):
+//
+//   ✘ Test aPostStillWorksAfterARequestIsAbandoned() recorded an issue at
+//     LikeConvergenceRegressionTests.swift:562:26: Issue recorded
+//   ↳ never reached: the first request was not given up on
+//   [feed] like write failed: ... (Swift.CancellationError error 1.)
+//   ✘ Test aPostStillWorksAfterARequestIsAbandoned() failed after 0.852 seconds with 1 issue.
+//
+// The claim under test: ManualDeadline.pass() releases only timers already
+// parked, and on the slow runner the model's timer parked *after* the test
+// passed. `LateTimerDeadline` below is ManualDeadline as it is at HEAD with one
+// change - the timer parks late, and the lateness is ordered against the test
+// on the main actor rather than left to the scheduler - so the ordering the
+// runner produced by chance happens here every time. No product code changes.
+//
+// Run: -only-testing:PetNoteAppTests/ReproCI35924362700Tests
+// Expected: reproduce_CI_35924362700 FAILS with exactly one issue,
+// "never reached: the first request was not given up on" (the CI message),
+// followed in the log by "[feed] like write failed: ... CancellationError";
+// the two fixedTest... cases PASS.
+
+import Foundation
+import Testing
+
+@testable import PetNote
+
+@MainActor
+struct ReproCI35924362700Tests {
+    typealias Base = LikeConvergenceRegressionTests
+
+    /// The body of aPostStillWorksAfterARequestIsAbandoned exactly as it was at
+    /// 3b4f497 (`deadline.pass()` the moment the request reaches the
+    /// repository). Only the deadline object differs: its timer parks late.
+    @Test func reproduce_CI_35924362700() async {
+        let feed = Base.Feed()
+        feed.page = [Base.post(likeCount: 10)]
+        let likes = Base.Likes()
+        let deadline = LateTimerDeadline(.parks, after: { likes.calls.count >= 1 })
+        let model = FeedViewModel(feed: feed, likes: likes, pageSize: 1, sleeper: deadline.sleeper)
+        await model.loadFirstPageIfNeeded()
+
+        likes.neverAnswer = true
+        model.toggleLike(model.posts[0])
+        await Base.settle(until: { likes.calls.count == 1 }, "the like request went out")
+        let armedAtPass = deadline.armed // instrumentation, not in the 3b4f497 body
+        deadline.pass()
+        await Base.settle(until: { model.likeFailureMessage != nil }, "the first request was not given up on")
+        likes.stopNeverAnswering()
+        await model.waitForPendingLikes()
+
+        likes.liked = ["p"]
+        model.toggleLike(model.posts[0])
+        await Base.settle(until: { likes.calls.count == 2 }, "the second tap never reached the repository")
+        await model.waitForPendingLikes()
+
+        #expect(deadline.durations.count == 2, "each request starts its own deadline: \(deadline.durations)")
+        #expect(model.isLiked(Base.post(likeCount: 10)))
+        #expect(model.displayLikeCount(for: model.posts[0]) == 11)
+        // Instrumentation: shows the injection did what it says. Passes.
+        #expect(armedAtPass == 0, "the injection did not take: the timer was already parked at pass()")
+    }
