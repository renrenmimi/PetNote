+@Suite(.serialized)
+struct ReproCI35905119437StressTests {
+    /// The path the hypothesis gives the CI crash: three ExploreModel.load()
+    /// at once on one 44f8d99 fake (as three renders' `.task`s would), a fresh
+    /// fake - and so a fresh, small array - every round.
+    @MainActor @Test func threeLoadsAtOnceOnThe44f8d99Fake() async {
+        let rounds = 3_000
+        var lostRounds = 0
+        for _ in 0..<rounds {
+            let search = Unlocked44f8d99SearchRepository()
+            let social = FakeSocialRepository()
+            let blocks = BlockList(viewerID: "me", social: social)
+            let explore = ExploreModel(viewerID: "me", search: search, social: social, blockList: blocks)
+            async let a: Void = explore.load()
+            async let b: Void = explore.load()
+            async let c: Void = explore.load()
+            _ = await (a, b, c)
+            if search.sinceQueries.count != 3 { lostRounds += 1 }
+        }
+        #expect(lostRounds == 0, "\(lostRounds) of \(rounds) rounds lost a recorded read to the race")
+    }
+
+    /// The same unlocked append, amplified: four threads, 64 calls each.
+    @Test func fourThreadsOnThe44f8d99Fake() async {
+        let rounds = 500
+        var lostRounds = 0
+        for _ in 0..<rounds {
+            let search = Unlocked44f8d99SearchRepository()
+            await withTaskGroup(of: Void.self) { group in
+                for _ in 0..<4 {
+                    group.addTask {
+                        for _ in 0..<64 { _ = try? await search.posts(since: Date(), limit: 30) }
+                    }
+                }
+            }
+            if search.sinceQueries.count != 256 { lostRounds += 1 }
+        }
+        #expect(lostRounds == 0, "\(lostRounds) of \(rounds) rounds lost a recorded read to the race")
+    }
+
+    /// Control: HEAD's locked fake (8915ac2) under the same four threads.
+    /// Expected: passes, every round, and no crash.
+    @Test func fourThreadsOnTheLockedFake() async {
+        let rounds = 500
+        var lostRounds = 0
+        for _ in 0..<rounds {
+            let search = FakeSearchRepository()
+            await withTaskGroup(of: Void.self) { group in
+                for _ in 0..<4 {
+                    group.addTask {
+                        for _ in 0..<64 { _ = try? await search.posts(since: Date(), limit: 30) }
+                    }
+                }
+            }
+            if search.sinceQueries.count != 256 { lostRounds += 1 }
+        }
+        #expect(lostRounds == 0, "\(lostRounds) of \(rounds) rounds lost a recorded read with the lock in place")
+    }
+}
