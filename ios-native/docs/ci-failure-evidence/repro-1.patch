+// TEMPORARY - DO NOT COMMIT. Evidence for the owner (2026-09-23), not a test
+// of the app. Remove with `git apply -R repro-1.patch` or by deleting this file.
+//
+// CI run 35905119437 (44f8d99): the unit-test process died with SIGSEGV
+// (EXC_BAD_ACCESS, KERN_INVALID_ADDRESS, "possible pointer authentication
+// failure") on a cooperative-pool thread in
+//   Array.append -> _reserveCapacityAssumingUniqueBuffer -> _consumeAndCreateNew
+//   -> swift_release -> _swift_release_dealloc
+// called from FakeSearchRepository.posts(since:limit:) at
+// SocialFixturesTests.swift:374 (`sinceQueries.append`), from
+// ExploreModel.load() -> loadTrending(). It died while
+// SocialRenderTests.thePetPagesSocialRowGrowsWithTheText was running, right
+// after discoveryGrowsWithTheText had passed.
+//
+// One load() appends to `sinceQueries` once, so a race on it needs two load()
+// calls in flight on the same fake. discoveryGrowsWithTheText's own load() had
+// returned before it passed; the only other callers of ExploreModel.load() are
+// SearchView's `.task` and `.refreshable`. Hypothesis: ImageRenderer starts
+// SearchView's `.task` (contrary to SocialRenderTests' note "runs no .task"),
+// the three renders start three loads together, and those outlive the test.
+//
+// Two suites, run separately:
+//
+// 1. -only-testing:PetNoteAppTests/ReproCI35905119437RenderTaskTests
+//    Deterministic yes/no on the hypothesis. PASSES if the renders start two or
+//    more explore loads at once (hypothesis holds); FAILS with the counts if
+//    not (then the second racer was something else). Prints a
+//    "REPRO-1 render:" line with the counts either way.
+//
+// 2. -only-testing:PetNoteAppTests/ReproCI35905119437StressTests
+//    NOT deterministic. The 44f8d99 fake, copied verbatim (no lock), under
+//    concurrent callers. Expected: the two unlocked cases either FAIL with
+//    "N of M rounds lost a recorded read" or the process CRASHES (xcodebuild:
+//    "Restarting after unexpected exit, crash, or test timeout"; the .ips in
+//    ~/Library/Logs/DiagnosticReports/PetNote-*.ips should show Array.append
+//    under Unlocked44f8d99SearchRepository.posts(since:limit:)). The locked
+//    control (HEAD's FakeSearchRepository) PASSES. A clean pass of an unlocked
+//    case does not disprove the race; it only means the window was not hit.
+
+import Foundation
+import SwiftUI
+import Testing
+import UIKit
+
+@testable import PetNote
+
+@MainActor
+struct ReproCI35905119437RenderTaskTests {
+    @Test func theRendersStartTheSearchScreensTask() async {
+        let search = CountingSearchRepository()
+        let social = FakeSocialRepository()
+        let blocks = BlockList(viewerID: "me", social: social)
+        let explore = ExploreModel(viewerID: "me", search: search, social: social, blockList: blocks)
+        let model = SearchModel(viewerID: "me", search: search, blockList: blocks)
+        // Deliberately no `await explore.load()`: every read counted below is
+        // one the view started. Rendered as SocialRenderTests.renders does.
+        let variants: [(ColorScheme, DynamicTypeSize)] = [(.light, .large), (.dark, .large), (.light, .accessibility5)]
+        for (scheme, size) in variants {
+            let renderer = ImageRenderer(
+                content: SearchView(
+                    search: model, explore: explore,
+                    onOpenPet: { _ in }, onOpenUser: { _ in }, onOpenPost: { _ in }
+                )
+                .environment(\.colorScheme, scheme)
+                .environment(\.dynamicTypeSize, size)
+                .frame(width: 402)
+                .background(Palette.background)
+            )
+            renderer.scale = 2
+            _ = renderer.uiImage
+        }
+        for _ in 0..<20_000 {
+            if search.trendingReads >= variants.count { break }
+            await Task.yield()
+        }
+        let reads = search.trendingReads
+        let atOnce = search.mostTrendingReadsAtOnce
+        print("REPRO-1 render: \(reads) trending reads started by \(variants.count) renders, at most \(atOnce) in flight at once")
+        #expect(reads >= 2, "the renders started \(reads) explore load(s); the CI race needs two on one fake")
+        #expect(atOnce >= 2, "at most \(atOnce) trending read(s) were in flight at once")
+    }
+}
