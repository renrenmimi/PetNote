<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Emulator-only Firebase options. Every value here is a placeholder: the
	  emulator does not authenticate the app, and the SDK only needs these
	  fields to be present and well-formed.

	  The production GoogleService-Info.plist is NOT in this repository and must
	  not be added to it. When a production build is needed, the file goes in
	  Config/Firebase/ locally and stays gitignored.
	-->
	<key>API_KEY</key>
	<string>emulator-no-key-required</string>
	<key>GCM_SENDER_ID</key>
	<string>000000000000</string>
	<key>PROJECT_ID</key>
	<string>petnote-test</string>
	<key>STORAGE_BUCKET</key>
	<string>petnote-test.appspot.com</string>
	<key>BUNDLE_ID</key>
	<string>dev.local.petnote.native</string>
	<key>GOOGLE_APP_ID</key>
	<string>1:000000000000:ios:0000000000000000000000</string>
	<key>IS_ADS_ENABLED</key>
	<false/>
	<key>IS_ANALYTICS_ENABLED</key>
	<false/>
	<key>IS_APPINVITE_ENABLED</key>
	<false/>
	<key>IS_GCM_ENABLED</key>
	<false/>
	<key>IS_SIGNIN_ENABLED</key>
	<false/>
	<key>PLIST_VERSION</key>
	<string>1</string>
</dict>
</plist>
