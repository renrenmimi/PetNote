<?xml version="1.0" encoding="UTF-8"?>
<!--
  The Capacitor app's launch screen, rebuilt around the same paw.

  The Capacitor storyboard filled the screen with one 2732x2732 PNG, a white
  canvas with the paw in the middle. iOS refuses to draw it: on 09-25 the iOS 27
  simulator logged "Estimated size (29900800) is over limit (25000000)" for it
  on every launch and denylisted the app, which then launched to black.

  So the canvas is not carried over and not resized either. What it showed was
  measured instead - aspect-fill of that canvas on a 402x874 screen, compared
  with this screen on the same simulator - and this draws the paw from
  BrandMark (the web client's paw-icon.svg, byte for byte) in a 262pt box,
  centred: the brown of the paw then spans 153x173pt around 190,442 in both.
  The paw sits a little left of and below the middle because the drawing
  does, in its own box.

  White in dark mode too, as the canvas was.
-->
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="17132" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="17105"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="Ze5-6b-2t3">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="BrandMark" translatesAutoresizingMaskIntoConstraints="NO" id="Pw1-mk-7Qa">
                                <rect key="frame" x="56.5" y="202.5" width="262" height="262"/>
                                <constraints>
                                    <constraint firstAttribute="width" constant="262" id="Wd1-mk-7Qa"/>
                                    <constraint firstAttribute="height" constant="262" id="Ht1-mk-7Qa"/>
                                </constraints>
                            </imageView>
                        </subviews>
                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                        <constraints>
                            <constraint firstItem="Pw1-mk-7Qa" firstAttribute="centerX" secondItem="Ze5-6b-2t3" secondAttribute="centerX" id="Cx1-mk-7Qa"/>
                            <constraint firstItem="Pw1-mk-7Qa" firstAttribute="centerY" secondItem="Ze5-6b-2t3" secondAttribute="centerY" id="Cy1-mk-7Qa"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="BrandMark" width="100" height="100"/>
    </resources>
</document>
