    "2–30 characters. Letters, numbers and spaces are fine, and it has to be unique.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "2–30 个字符，可以使用字母、数字和空格，且不能与他人重名。"
