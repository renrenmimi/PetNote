          }
        }
      }
    },
    "We could not check that name. You can still save.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法检查这个名字，你仍然可以保存。"
          }
        }
      }
    },
    "We could not confirm that comment was posted, and could not check either. Refresh before sending it again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确认评论是否已发出，也无法核实。再次发送前请先刷新。"
