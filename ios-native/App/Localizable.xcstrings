    "%@ (you)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@（你）"
          }
        }
      }
    },
    "%@ Press Share again — it won't post twice.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 再点一次「发布」即可，不会重复发布。"
          }
        }
      }
    },
    "%@ becomes %@'s primary owner. You stay an owner and can still edit and post — but they, not you, will be the one who can remove other owners.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将成为 %@ 的主要主人。你仍然是主人，可以继续编辑和发帖——但之后能移除其他主人的将是对方，而不是你。"
          }
        }
      }
    },
    "%@ is no longer an owner.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已不再是主人。"
          }
        }
      }
    },
    "%@ is now %@'s primary owner.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 现在是 %@ 的主要主人。"
