    },
    "%@ no longer exists.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已不存在。"
          }
        }
      }
    },
    "%@ was already no longer an owner.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 此前就已不再是主人。"
          }
        }
      }
    },
    "%@ will lose access to %@. Anything they already posted stays. They can only come back through a new invitation.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 将无法再访问 %@。对方已发布的内容会保留，之后只能通过新的邀请重新加入。"
          }
        }
      }
    },
