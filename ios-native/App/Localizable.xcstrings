    },
    "We could not tell whether you joined. Check your pets, or try again.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定你是否已加入。请查看你的宠物列表，或者重试。"
