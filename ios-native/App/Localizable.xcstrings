          "stringUnit": {
            "state": "translated",
            "value": "可以玩水"
          }
        }
      }
    },
    "We checked, and your comment is not in the list. It is still here — send it again if you want to.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
