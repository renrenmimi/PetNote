    },
    "We could not tell whether the pet was created. Check your pets before trying again — sending this twice would make two.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法确定宠物是否已创建。重试前请先查看你的宠物列表——重复提交会创建两只。"
          }
