          }
        }
      }
    },
    "You will lose access to %@. Your posts about %@ stay, and you can only come back through a new invitation. The primary owner role passes to whoever has been an owner the longest.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
