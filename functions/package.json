{
  "name": "petnote-functions",
  "description": "PetNote Cloud Functions",
  "scripts": {
    "build": "tsc",
    "lint": "eslint .",
    "migrate:admin-state": "node scripts/migrate-admin-state.js",
    "serve": "npm run build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "test": "vitest run",
    "test:emulator": "firebase emulators:exec --only firestore,auth --project petnote-test \"npm test\"",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json"
  },
  "engines": {
    "node": "22"
  },
  "main": "lib/index.js",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.3.2"
  },
  "overrides": {
    "@tootallnate/once": "^3.0.1",
    "http-proxy-agent": "^7.0.2",
    "retry-request": "^8.0.2",
    "teeny-request": "^10.1.2",
    "uuid": "^14.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.7"
  },
  "private": true
}
