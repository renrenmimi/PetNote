VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Firebase App Check (optional, unenforced).
# Leave both blank and App Check does not initialise at all — that is the
# expected state until a reCAPTCHA Enterprise key exists in the Firebase
# console. See docs/app-check-rollout.md before setting them.
VITE_FIREBASE_APPCHECK_SITE_KEY=
# Development only. reCAPTCHA Enterprise cannot attest localhost, so local runs
# use a debug token registered in the console. Never set this in production.
VITE_FIREBASE_APPCHECK_DEBUG_TOKEN=

# Numeric-code password reset (off by default).
# Set to 1 only in an environment where the transactional email secrets
# (TRANSACTIONAL_EMAIL_API_KEY, TRANSACTIONAL_EMAIL_FROM) and
# PASSWORD_RESET_CODE_SECRET are set for the functions. With it unset, Forgot
# Password keeps sending Firebase's own reset link, which works today; with it
# set in an environment that has no mail provider, people who already cannot
# sign in would be sent into a flow that cannot finish.
VITE_PASSWORD_RESET_OTP=
